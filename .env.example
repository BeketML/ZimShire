# =============================================================================
# ZimShire — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Postgres (docker-compose + local dev) -----------------------------------
POSTGRES_USER=zimshire
POSTGRES_PASSWORD=change_me
POSTGRES_DB=zimshire
POSTGRES_PORT=5432

# Local dev (host connects to localhost):
DATABASE_URL=postgresql+asyncpg://zimshire:change_me@localhost:5432/zimshire

# Docker Compose overrides DATABASE_URL internally for the api service.
# Use service hostname `postgres` when running app inside Docker manually.

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=buffett_letters

# --- API / MCP ports ----------------------------------------------------------
API_PORT=8000
MCP_PORT=8001
MCP_BASE_URL=http://localhost:8001

# --- LiteLLM gateway (Zimran virtual key — required for all LLM calls) -------
LITELLM_BASE_URL=https://litellm.zimran.net
LITELLM_API_KEY=your_virtual_key_here
LITELLM_END_USER_ID=your.email@example.com

# --- Per-role models (server-side only; clients cannot override) --------------
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai
ORCHESTRATOR_MODEL=claude-sonnet-4-6
SUBAGENT_MODEL=claude-haiku-4-5
GUARDRAIL_MODEL=gpt-4o-mini
MEMORY_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse observability (optional but recommended) ------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Web search (SerpApi DuckDuckGo engine — required for web subagent) -------
DUCKDUCKGO_API_KEY=

# --- Guardrails ---------------------------------------------------------------
# true = allow query through when guardrail LLM fails; false = block
FAIL_OPEN_ON_GUARDRAIL_ERROR=true

# --- Runtime thresholds (app/core/config.py) ----------------------------------
SEMANTIC_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_DAYS=7
MARKET_CACHE_TTL_HOURS=1
FAITHFULNESS_SCORE_THRESHOLD=0.40
FAITHFULNESS_MIN_STRONG_HITS=2
OUTPUT_GUARDRAIL_MAX_RETRIES=2
SHORT_TERM_TURN_PAIRS=5

# --- pgAdmin (optional, docker-compose only) ----------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050
